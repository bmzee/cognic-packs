#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == version ]]; then
  printf '%s\n' 'GitVersion:    v3.1.3'
  exit 0
fi
[[ "${1:-}" == verify-blob ]] || exit 2
shift
bundle=''
target=''
seen_key=false
seen_tlog=false
seen_root=false
seen_timestamp=false
while (( $# > 0 )); do
  case "$1" in
    --bundle) bundle=${2:-}; shift 2 ;;
    --key) seen_key=true; shift 2 ;;
    --insecure-ignore-tlog=true) seen_tlog=true; shift ;;
    --trusted-root) seen_root=true; shift 2 ;;
    --use-signed-timestamps) seen_timestamp=true; shift ;;
    --*) exit 2 ;;
    *) target=$1; shift ;;
  esac
done
[[ -n "$bundle" && -n "$target" ]] || exit 2
[[ "$seen_key" == true && "$seen_tlog" == true && "$seen_root" == true && "$seen_timestamp" == true ]] || exit 2
[[ "${FAKE_COSIGN_VERIFY_FAIL:-false}" != true ]] || exit 1
expected=$(jq -er '.sha256' "$bundle")
actual=$(sha256sum "$target" | awk '{print $1}')
[[ "$expected" == "$actual" ]]
printf 'verify:%s\n' "${target##*/}" >> "${FAKE_COSIGN_LOG:?}"
