#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == version ]]; then
  printf '%s\n' 'GitVersion:    v3.1.3'
  exit 0
fi
state_dir=${FAKE_COSIGN_STATE_DIR:?}
mkdir -p "$state_dir"
command_name=${1:-}
shift || true

case "$command_name" in
  sign)
    bundle=''
    annotation=''
    target=''
    while (( $# > 0 )); do
      case "$1" in
        --yes|--tlog-upload=false) shift ;;
        --key|--signing-config|--trusted-root) shift 2 ;;
        --bundle) bundle=${2:-}; shift 2 ;;
        --annotations) annotation=${2:-}; shift 2 ;;
        --*) exit 2 ;;
        *) target=$1; shift ;;
      esac
    done
    [[ -n "$bundle" && -n "$target" ]] || exit 2
    [[ "$annotation" == dev.cognic.pack.content-sha256=* ]] || exit 2
    digest=${target##*@}
    content=${annotation#*=}
    jq -n --arg digest "$digest" --arg content "$content" \
      '{digest: $digest, contentSha256: $content}' > "${state_dir}/oci.json"
    jq -n --arg target "$target" '{kind: "oci", subject: $target}' > "$bundle"
    printf 'sign-oci:%s\n' "$target" >> "${FAKE_COSIGN_LOG:?}"
    ;;
  verify)
    target=''
    seen_key=false
    seen_tlog=false
    seen_root=false
    seen_timestamp=false
    seen_json=false
    while (( $# > 0 )); do
      case "$1" in
        --key) seen_key=true; shift 2 ;;
        --insecure-ignore-tlog=true) seen_tlog=true; shift ;;
        --trusted-root) seen_root=true; shift 2 ;;
        --use-signed-timestamps) seen_timestamp=true; shift ;;
        --output=json) seen_json=true; shift ;;
        --*) exit 2 ;;
        *) target=$1; shift ;;
      esac
    done
    [[ "$seen_key" == true && "$seen_tlog" == true && "$seen_root" == true ]] || exit 2
    [[ "$seen_timestamp" == true && "$seen_json" == true && -n "$target" ]] || exit 2
    [[ "${FAKE_COSIGN_VERIFY_FAIL:-false}" != true ]] || exit 1
    digest=$(jq -er '.digest' "${state_dir}/oci.json")
    content=$(jq -er '.contentSha256' "${state_dir}/oci.json")
    [[ "${target##*@}" == "$digest" ]] || exit 1
    jq -n --arg digest "$digest" --arg content "$content" '[{
      critical: {image: {"docker-manifest-digest": $digest}},
      optional: {"dev.cognic.pack.content-sha256": $content}
    }]'
    printf 'verify-oci:%s\n' "$target" >> "${FAKE_COSIGN_LOG:?}"
    ;;
  sign-blob)
    bundle=''
    target=''
    while (( $# > 0 )); do
      case "$1" in
        --yes) shift ;;
        --key|--signing-config|--trusted-root) shift 2 ;;
        --bundle) bundle=${2:-}; shift 2 ;;
        --*) exit 2 ;;
        *) target=$1; shift ;;
      esac
    done
    [[ -n "$bundle" && -n "$target" ]] || exit 2
    jq -n --arg sha256 "$(sha256sum "$target" | awk '{print $1}')" \
      '{sha256: $sha256}' > "$bundle"
    printf 'sign-blob:%s\n' "${target##*/}" >> "${FAKE_COSIGN_LOG:?}"
    ;;
  verify-blob)
    bundle=''
    target=''
    seen_key=false
    seen_tlog=false
    seen_root=false
    seen_timestamp=false
    while (( $# > 0 )); do
      case "$1" in
        --bundle) bundle=${2:-}; shift 2 ;;
        --key) seen_key=true; shift 2 ;;
        --insecure-ignore-tlog=true) seen_tlog=true; shift ;;
        --trusted-root) seen_root=true; shift 2 ;;
        --use-signed-timestamps) seen_timestamp=true; shift ;;
        --*) exit 2 ;;
        *) target=$1; shift ;;
      esac
    done
    [[ "$seen_key" == true && "$seen_tlog" == true && "$seen_root" == true ]] || exit 2
    [[ "$seen_timestamp" == true && -n "$bundle" && -n "$target" ]] || exit 2
    [[ "${FAKE_COSIGN_VERIFY_FAIL:-false}" != true ]] || exit 1
    expected=$(jq -er '.sha256' "$bundle")
    actual=$(sha256sum "$target" | awk '{print $1}')
    [[ "$expected" == "$actual" ]] || exit 1
    printf 'verify-blob:%s\n' "${target##*/}" >> "${FAKE_COSIGN_LOG:?}"
    ;;
  *) exit 2 ;;
esac
